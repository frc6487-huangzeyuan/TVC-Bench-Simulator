work/studio_project.json

# Compiled controller snapshots imported from external flight-control projects
work/controllers/

# Real device telemetry belongs to the local user, not source control
real_runs/

# Generic local/build artifacts
*.pdb
*.ilk
.DS_Store
Thumbs.db
