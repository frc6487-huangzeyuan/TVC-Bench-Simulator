# Python environment and caches
.venv/
venv/
__pycache__/
*.py[cod]

# Frontend dependencies/build cache
frontend/node_modules/
frontend/dist/
frontend/tsconfig.tsbuildinfo

# Local browser runtime data (may contain cookies/login state)
work/browser-profile/
